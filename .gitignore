# arsiv/ depoya girmez; tek istisna cl_ref.npz (ureteci hic repoya girmedi,
# yeniden uretilemez birincil varlik). Git ignore'lu dizine inmedigi icin
# istisna asama asama yeniden dahil edilir.
/arsiv/*
!/arsiv/veri/
/arsiv/veri/*
!/arsiv/veri/cl_ref.npz

